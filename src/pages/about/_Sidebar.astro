---
import { socials } from "./data";
---

<div class="flex flex-col justify-between h-full">
  <p class="text-sm leading-relaxed">
    <i>Mariana Ângelo</i> is a creative and versatile graphic/editorial designer and
    illustrator with a passion for music, fashion, photography and cinema. She brings
    a unique blend of artistic techniques and skill to every project, crafting visually
    compelling designs that tell a story. Whether working on a minimalist editorial
    layout or a vibrant illustration, she thrives on pushing her creative boundaries
    and staying inspired by the world around her.
  </p>
  <ul class="flex gap-6 mt-8">
    {
      socials.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs uppercase"
          >
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>
