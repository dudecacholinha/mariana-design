---
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  pageTitle: string;
}
const { pageTitle } = Astro.props;
---

<BaseLayout pageTitle={pageTitle} scrollLocked>
  <div class="flex flex-col md:flex-row md:h-full md:min-h-0">
    <aside
      class="md:w-72 md:overflow-y-auto md:shrink-0 p-8 md:border-r border-dark/10"
    >
      <slot name="sidebar" />
    </aside>
    <main class="flex-1 md:overflow-y-auto p-8">
      <slot />
    </main>
  </div>
</BaseLayout>
