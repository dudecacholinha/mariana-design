---
import SkillDot from "@components/SkillDot.astro";

interface Props {
  label: string;
  value: number;
  max?: number;
}
const { label, value, max = 5 } = Astro.props;
---

<div class="flex items-center gap-3">
  <span class="w-36 shrink-0 text-xs uppercase">{label}</span>
  <div class="flex gap-px shrink-0">
    {Array.from({ length: max }).map((_, i) => <SkillDot filled={i < value} />)}
  </div>
</div>
