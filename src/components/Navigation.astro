---
const navItems = [
  { href: "/about", label: "About" },
  { href: "/archive", label: "Archive" },
  { href: "/contact", label: "Contact" },
];
---

<nav
  class="hidden md:flex items-center justify-between px-8 h-nav fixed top-0 left-0 right-0 z-50 bg-purple"
>
  <a href="/" class="text-xl font-medium">Marianâ</a>
  <ul class="flex gap-8">
    {
      navItems.map((link) => (
        <li>
          <a href={link.href} class="text-xs">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<nav
  class="fixed bottom-0 left-0 right-0 flex items-center justify-around px-4 py-3 z-50 md:hidden"
>
  <ul class="flex gap-6">
    {
      navItems.map((link) => (
        <li>
          <a href={link.href} class="text-xs">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
