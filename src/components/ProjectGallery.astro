---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  alt?: string;
}

const { images, alt = "" } = Astro.props;
---

<div class="flex flex-col gap-4">
  {
    images.map((img) => (
      <Image src={img} alt={alt} class="w-full h-auto rounded-lg" />
    ))
  }
</div>
